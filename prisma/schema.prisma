model ProductionSetting {
  id              String   @id @default("default")
  handicapPercent Decimal  @default(0) @map("handicap_percent") @db.Decimal(6, 2)
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @map("updated_by")

  updatedByUser User? @relation("ProductionSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("production_settings")
}

model ProductionOrder {
  id                 String               @id @default(cuid())
  folio              String               @unique
  sourceType         ProductionSourceType @map("source_type")
  clientId           String               @map("client_id")
  quoteId            String?              @map("quote_id")
  approvalDate       DateTime             @map("approval_date") @db.Date
  status             ProductionStatus     @default(PENDING)
  totalItems         Int                  @default(0) @map("total_items")
  completedItems     Int                  @default(0) @map("completed_items")
  progressPercentage Decimal              @default(0) @map("progress_percentage") @db.Decimal(8, 2)
  startedAt          DateTime?            @map("started_at")
  completedAt        DateTime?            @map("completed_at")
  materialsReadyAt   DateTime?            @map("materials_ready_at")
  materialsReadyBy   String?              @map("materials_ready_by")
  estimatedDeliveryDate DateTime?         @map("estimated_delivery_date") @db.Date
  reprintOfId        String?              @map("reprint_of_id")
  reprintReason      String?              @map("reprint_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  client               Client            @relation(fields: [clientId], references: [id])
  quote                Quote?            @relation("QuoteProductionOrders", fields: [quoteId], references: [id], onDelete: SetNull)
  latestForQuote       Quote?            @relation("QuoteLatestProduction")
  directOrder          DirectOrder?      @relation("DirectOrderProduction")
  materialsReadyByUser User?             @relation("ProductionMaterialsReadyBy", fields: [materialsReadyBy], references: [id], onDelete: SetNull)
  reprintOf            ProductionOrder?  @relation("ProductionReprints", fields: [reprintOfId], references: [id], onDelete: SetNull)
  reprints             ProductionOrder[] @relation("ProductionReprints")
  items                ProductionItem[]
  purchaseOrders       PurchaseOrder[]
  attachments          ProductionAttachment[]
  activities           ProductionActivity[]
  incidents            ProductionIncident[]
  extraMaterials       ProductionExtraMaterial[]
  timeSessions         ProductionTimeSession[]

  @@index([status, approvalDate])
  @@index([clientId])
  @@index([quoteId])
  @@map("production_orders")
}

model ProductionAttachment {
  id                String  @id @default(cuid())
  productionOrderId String  @map("production_order_id")
  productionItemId  String? @map("production_item_id")
  processId         String? @map("process_id")
  incidentId        String? @map("incident_id")
  activityId        String? @map("activity_id")
