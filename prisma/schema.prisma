  assignedToUser User?                       @relation("ProductionProcessAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  replacedByUser User?                       @relation("ProductionProcessReplacedBy", fields: [replacedBy], references: [id], onDelete: SetNull)
  createdByUser  User?                       @relation("ProductionProcessCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser  User?                       @relation("ProductionProcessUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  replacedProcess ProductionItemProcess?     @relation("ProductionProcessReplacement", fields: [replacedProcessId], references: [id], onDelete: SetNull)
  replacements    ProductionItemProcess[]    @relation("ProductionProcessReplacement")
  sessions        ProductionTimeSession[]
  activities      ProductionActivity[]
  incidents       ProductionIncident[]
  extraMaterials  ProductionExtraMaterial[]
  attachments     ProductionAttachment[]

  @@index([productionItemId, sortOrder])
  @@index([manufacturingProcessId])
  @@index([assignedToUserId])
  @@map("production_item_processes")
}

model ProductionActivity {
  id                String                 @id @default(cuid())
  productionOrderId String                 @map("production_order_id")
  productionItemId  String?                @map("production_item_id")
  processId         String?                @map("process_id")
  incidentId        String?                @map("incident_id")
  extraMaterialId   String?                @map("extra_material_id")
  type              ProductionActivityType
  body              String?
  payload           Json?
  createdBy         String?                @map("created_by")
  createdAt         DateTime               @default(now()) @map("created_at")

  productionOrder ProductionOrder        @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionItem  ProductionItem?        @relation(fields: [productionItemId], references: [id], onDelete: SetNull)
  process         ProductionItemProcess? @relation(fields: [processId], references: [id], onDelete: SetNull)
  incident        ProductionIncident?    @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  extraMaterial   ProductionExtraMaterial? @relation(fields: [extraMaterialId], references: [id], onDelete: SetNull)
  createdByUser   User?                  @relation("ProductionActivityCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  attachments     ProductionAttachment[]

  @@index([productionOrderId, createdAt])
  @@index([productionItemId, createdAt])
  @@index([type])
  @@map("production_activities")
}

model ProductionTimeSession {
  id                String                       @id @default(cuid())
  productionOrderId String                       @map("production_order_id")
  productionItemId  String                       @map("production_item_id")
  processId         String                       @map("process_id")
  userId            String                       @map("user_id")
  status            ProductionTimeSessionStatus  @default(RUNNING)
  startedAt         DateTime                     @map("started_at")
  lastResumedAt     DateTime                     @map("last_resumed_at")
  pausedAt          DateTime?                    @map("paused_at")
  endedAt           DateTime?                    @map("ended_at")
  accumulatedMinutes Decimal                     @default(0) @map("accumulated_minutes") @db.Decimal(14, 3)
  durationMinutes   Decimal                      @default(0) @map("duration_minutes") @db.Decimal(14, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  productionOrder ProductionOrder       @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionItem  ProductionItem        @relation(fields: [productionItemId], references: [id], onDelete: Cascade)
  process         ProductionItemProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  user            User                  @relation("ProductionTimeSessionUser", fields: [userId], references: [id])

  @@index([userId, status])
  @@index([processId, status])
  @@index([productionItemId])
  @@map("production_time_sessions")
}

model ProductionIncident {
  id                String                    @id @default(cuid())
  productionOrderId String                    @map("production_order_id")
  productionItemId  String?                   @map("production_item_id")
  processId         String?                   @map("process_id")
  extraMaterialId   String?                   @map("extra_material_id")
  type              ProductionIncidentType    @default(OTHER)
  status            ProductionIncidentStatus  @default(OPEN)
  blocking          Boolean                   @default(false)
  title             String
  description       String
  actionTaken       String?                   @map("action_taken")
  assignedToUserId  String?                   @map("assigned_to_user_id")
  reportedBy        String?                   @map("reported_by")
  resolvedAt        DateTime?                 @map("resolved_at")
  closedAt          DateTime?                 @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  productionOrder ProductionOrder        @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionItem  ProductionItem?        @relation(fields: [productionItemId], references: [id], onDelete: SetNull)
  process         ProductionItemProcess? @relation(fields: [processId], references: [id], onDelete: SetNull)
  extraMaterial   ProductionExtraMaterial? @relation(fields: [extraMaterialId], references: [id], onDelete: SetNull)
  reportedByUser  User?                  @relation("ProductionIncidentReportedBy", fields: [reportedBy], references: [id], onDelete: SetNull)
  assignedToUser  User?                  @relation("ProductionIncidentAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  attachments     ProductionAttachment[]
  activities      ProductionActivity[]

  @@index([productionOrderId, status])
  @@index([productionItemId, status])
  @@index([blocking, status])
  @@map("production_incidents")
}

model ProductionExtraMaterial {
  id                String   @id @default(cuid())
  productionOrderId String   @map("production_order_id")
  productionItemId  String?  @map("production_item_id")
  processId         String?  @map("process_id")
  catalogItemId     String?  @map("catalog_item_id")
  supplierId        String?  @map("supplier_id")
  description       String
  quantity          Decimal  @db.Decimal(14, 3)
  unit              String?
  unitCost          Decimal? @map("unit_cost") @db.Decimal(14, 2)
  reason            String
  occurredAt        DateTime @default(now()) @map("occurred_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  productionOrder ProductionOrder        @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionItem  ProductionItem?        @relation(fields: [productionItemId], references: [id], onDelete: SetNull)
  process         ProductionItemProcess? @relation(fields: [processId], references: [id], onDelete: SetNull)
  catalogItem     Item?                  @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  supplier        Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdByUser   User?                  @relation("ProductionExtraMaterialCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  incidents       ProductionIncident[]
  activities      ProductionActivity[]

  @@index([productionOrderId])
  @@index([productionItemId])
  @@map("production_extra_materials")
}

model ProductionScheduleChange {
  id                       String    @id @default(cuid())
  productionItemId         String    @map("production_item_id")
  previousPlannedStartAt   DateTime? @map("previous_planned_start_at") @db.Date
  previousPlannedEndAt     DateTime? @map("previous_planned_end_at") @db.Date
  previousCommitmentDate   DateTime? @map("previous_commitment_date") @db.Date
  newPlannedStartAt        DateTime? @map("new_planned_start_at") @db.Date
  newPlannedEndAt          DateTime? @map("new_planned_end_at") @db.Date
  newCommitmentDate        DateTime? @map("new_commitment_date") @db.Date
  reason                   String?
  createdBy                String?   @map("created_by")
  createdAt                DateTime  @default(now()) @map("created_at")

  productionItem ProductionItem @relation(fields: [productionItemId], references: [id], onDelete: Cascade)
  createdByUser  User?          @relation("ProductionScheduleChangeCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([productionItemId, createdAt])
  @@map("production_schedule_changes")
}

// -----------------------------------------------------------------------------
// Etapa 3 — Inventario
// -----------------------------------------------------------------------------
model InventoryStock {
  id                String  @id @default(cuid())
  warehouseId       String  @map("warehouse_id")
  itemId            String  @map("item_id")
  quantity          Decimal @default(0) @db.Decimal(14, 3)
  reservedQuantity  Decimal @default(0) @map("reserved_quantity") @db.Decimal(14, 3)
  availableQuantity Decimal @default(0) @map("available_quantity") @db.Decimal(14, 3)

  updatedAt DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])

  @@unique([warehouseId, itemId])
  @@index([itemId])
  @@index([warehouseId])
  @@map("inventory_stock")
}

model InventoryMovement {
  id                      String                 @id @default(cuid())
  folio                   String                 @unique
  warehouseId             String                 @map("warehouse_id")
  destinationWarehouseId  String?                @map("destination_warehouse_id")
  itemId                  String                 @map("item_id")
  movementType            MovementType           @map("movement_type")
  quantity                Decimal                @db.Decimal(14, 3)
  unitCost                Decimal?               @map("unit_cost") @db.Decimal(14, 2)
  referenceType           MovementReferenceType? @map("reference_type")
  referenceId             String?                @map("reference_id")
  reason                  String?
  notes                   String?
  movementDate            DateTime               @map("movement_date")
  createdBy               String                 @map("created_by")
  createdAt               DateTime               @default(now()) @map("created_at")

  warehouse            Warehouse  @relation("MovementWarehouse", fields: [warehouseId], references: [id])
  destinationWarehouse Warehouse? @relation("MovementDestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  item                 Item       @relation(fields: [itemId], references: [id])
  createdByUser        User       @relation("InventoryMovementCreatedBy", fields: [createdBy], references: [id])

  @@index([movementDate])
  @@index([warehouseId, itemId])
  @@index([referenceType, referenceId])
  @@index([movementType])
  @@map("inventory_movements")
}

model WarehouseTransfer {
  id                     String         @id @default(cuid())
  folio                  String         @unique
  sourceWarehouseId      String         @map("source_warehouse_id")
  destinationWarehouseId String         @map("destination_warehouse_id")
  status                 TransferStatus @default(DRAFT)
  notes                  String?
  requestedBy            String?        @map("requested_by")
  approvedBy             String?        @map("approved_by")
  completedBy            String?        @map("completed_by")
  requestedAt            DateTime?      @map("requested_at")
  approvedAt             DateTime?      @map("approved_at")
  completedAt            DateTime?      @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  sourceWarehouse      Warehouse @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse @relation("TransferDestination", fields: [destinationWarehouseId], references: [id])
  requestedByUser      User?     @relation("TransferRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)
  approvedByUser       User?     @relation("TransferApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  completedByUser      User?     @relation("TransferCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)
  items                WarehouseTransferItem[]

  @@index([status, requestedAt])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@map("warehouse_transfers")
}

model WarehouseTransferItem {
  id         String  @id @default(cuid())
  transferId String  @map("transfer_id")
  itemId     String  @map("item_id")
  quantity   Decimal @db.Decimal(14, 3)
  notes      String?

  transfer WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     Item              @relation(fields: [itemId], references: [id])

  @@index([transferId])
  @@index([itemId])
  @@map("warehouse_transfer_items")
}

// -----------------------------------------------------------------------------
// Etapa 3 — Ordenes de compra y recepciones
// -----------------------------------------------------------------------------
model PurchaseOrder {
  id                String              @id @default(cuid())
  folio             String              @unique
  productionOrderId String?             @map("production_order_id")
  quoteId           String?             @map("quote_id")
  supplierId        String              @map("supplier_id")
  requestedBy       String              @map("requested_by")
  authorizedBy      String?             @map("authorized_by")
  requestDate       DateTime            @map("request_date") @db.Date
  authorizationDate DateTime?           @map("authorization_date")
  expectedDate      DateTime?           @map("expected_date") @db.Date
  status            PurchaseOrderStatus @default(DRAFT)
  comments          String?
  subtotal          Decimal             @default(0) @db.Decimal(14, 2)
  tax               Decimal             @default(0) @db.Decimal(14, 2)
  total             Decimal             @default(0) @db.Decimal(14, 2)
  rejectionReason   String?             @map("rejection_reason")
  cancellationReason String?            @map("cancellation_reason")
  completedAt       DateTime?           @map("completed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  quote           Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  requestedByUser User             @relation("PurchaseOrderRequestedBy", fields: [requestedBy], references: [id])
  authorizedByUser User?           @relation("PurchaseOrderAuthorizedBy", fields: [authorizedBy], references: [id], onDelete: SetNull)
  items           PurchaseOrderItem[]
  receipts        PurchaseReceipt[]

  @@index([status, requestDate])
  @@index([supplierId])
  @@index([productionOrderId])
  @@index([quoteId])
  @@index([deletedAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                   String                  @id @default(cuid())
  purchaseOrderId      String                  @map("purchase_order_id")
  itemId               String                  @map("item_id")
  descriptionSnapshot  String                  @map("description_snapshot")
  quantity             Decimal                 @db.Decimal(14, 3)
  receivedQuantity     Decimal                 @default(0) @map("received_quantity") @db.Decimal(14, 3)
  unit                 String?
  unitPrice            Decimal                 @default(0) @map("unit_price") @db.Decimal(14, 2)
  subtotal             Decimal                 @default(0) @db.Decimal(14, 2)
  taxAmount            Decimal                 @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total                Decimal                 @default(0) @db.Decimal(14, 2)
  warehouseId          String?                 @map("warehouse_id")
  status               PurchaseOrderItemStatus @default(PENDING)
  sourceType           PurchaseOrderItemSourceType @default(MANUAL) @map("source_type")
  sourceMaterialId     String?                 @map("source_material_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])
  warehouse     Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  receiptItems  PurchaseReceiptItem[]

  @@index([purchaseOrderId])
  @@index([itemId])
  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id              String   @id @default(cuid())
  folio           String   @unique
  purchaseOrderId String   @map("purchase_order_id")
  supplierId      String   @map("supplier_id")
  warehouseId     String   @map("warehouse_id")
  receiptDate     DateTime @map("receipt_date") @db.Date
  notes           String?
  receivedBy      String   @map("received_by")
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  receivedByUser User         @relation("PurchaseReceiptReceivedBy", fields: [receivedBy], references: [id])
  items         PurchaseReceiptItem[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([warehouseId])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                         String  @id @default(cuid())
  purchaseReceiptId          String  @map("purchase_receipt_id")
  purchaseOrderItemId        String  @map("purchase_order_item_id")
  itemId                     String  @map("item_id")
  orderedQuantity            Decimal @map("ordered_quantity") @db.Decimal(14, 3)
  previouslyReceivedQuantity Decimal @map("previously_received_quantity") @db.Decimal(14, 3)
  receivedQuantity           Decimal @map("received_quantity") @db.Decimal(14, 3)
  unitCost                   Decimal @default(0) @map("unit_cost") @db.Decimal(14, 2)
  createdAt                  DateTime @default(now()) @map("created_at")

  purchaseReceipt   PurchaseReceipt   @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  item              Item              @relation(fields: [itemId], references: [id])

  @@index([purchaseReceiptId])
  @@index([purchaseOrderItemId])
  @@map("purchase_receipt_items")
}

// -----------------------------------------------------------------------------
// Dashboard de Ventas
// -----------------------------------------------------------------------------
enum SalesGoalPeriod {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL

  @@map("sales_goal_period")
}

enum MaterialSkipReason {
  IN_STOCK
  CLIENT_PROVIDED
  USE_SURPLUS
  NOT_APPLICABLE
  OTHER

  @@map("material_skip_reason")
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  @@map("holidays")
}

model SalesGoal {
  id        String          @id @default(cuid())
  period    SalesGoalPeriod
  periodKey String          @map("period_key")
  amount    Decimal         @db.Decimal(14, 2)
  label     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by")
  updatedBy String   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  createdByUser User @relation("SalesGoalCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User @relation("SalesGoalUpdatedBy", fields: [updatedBy], references: [id])
  sellers       SalesGoalSeller[]
  teams         SalesGoalTeam[]

  @@unique([period, periodKey])
  @@index([deletedAt])
  @@map("sales_goals")
}

model SalesGoalSeller {
  salesGoalId String @map("sales_goal_id")
  sellerId    String @map("seller_id")

  salesGoal SalesGoal @relation(fields: [salesGoalId], references: [id], onDelete: Cascade)
  seller    User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([salesGoalId, sellerId])
  @@index([sellerId])
  @@map("sales_goal_sellers")
}

model SalesGoalTeam {
  salesGoalId String @map("sales_goal_id")
  teamId      String @map("team_id")

  salesGoal SalesGoal @relation(fields: [salesGoalId], references: [id], onDelete: Cascade)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([salesGoalId, teamId])
  @@index([teamId])
  @@map("sales_goal_teams")
}

model SalesInvoice {
  id               String   @id @default(cuid())
  invoiceNumber    String   @unique @map("invoice_number")
  netAmount        Decimal  @map("net_amount") @db.Decimal(14, 2)
  invoiceDate      DateTime @map("invoice_date") @db.Date
  sellerId         String   @map("seller_id")
  clientPoNumber   String   @map("client_po_number")
  receivedByClient Boolean  @default(false) @map("received_by_client")
  receptionDate    DateTime? @map("reception_date") @db.Date
  notes            String?

  pdfPathname      String?  @map("pdf_pathname")
  pdfFileName      String?  @map("pdf_file_name")
  pdfUrl           String?  @map("pdf_url")
  pdfContentType   String?  @map("pdf_content_type")
  pdfSizeBytes     Int?     @map("pdf_size_bytes")
  xmlPathname      String?  @map("xml_pathname")
  xmlFileName      String?  @map("xml_file_name")
  xmlUrl           String?  @map("xml_url")
  xmlContentType   String?  @map("xml_content_type")
  xmlSizeBytes     Int?     @map("xml_size_bytes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String    @map("created_by")
  updatedBy String    @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  seller        User @relation("SalesInvoiceSeller", fields: [sellerId], references: [id])
  createdByUser User @relation("SalesInvoiceCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User @relation("SalesInvoiceUpdatedBy", fields: [updatedBy], references: [id])
  quotes        SalesInvoiceQuote[]

  @@index([sellerId, invoiceDate])
  @@index([receivedByClient])
  @@index([deletedAt])
  @@map("sales_invoices")
}

model SalesInvoiceQuote {
  id             String @id @default(cuid())
  salesInvoiceId String @map("sales_invoice_id")
  quoteId        String @map("quote_id")

  salesInvoice SalesInvoice            @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  quote        Quote                   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  items        SalesInvoiceQuoteItem[]

  @@unique([salesInvoiceId, quoteId])
  @@index([quoteId])
  @@map("sales_invoice_quotes")
}

model SalesInvoiceQuoteItem {
  id                  String @id @default(cuid())
  salesInvoiceQuoteId String @map("sales_invoice_quote_id")
  quoteItemId         String @map("quote_item_id")

  salesInvoiceQuote SalesInvoiceQuote @relation(fields: [salesInvoiceQuoteId], references: [id], onDelete: Cascade)
  quoteItem         QuoteItem         @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)

  @@unique([salesInvoiceQuoteId, quoteItemId])
  @@index([quoteItemId])
  @@map("sales_invoice_quote_items")
}

model MaterialPurchaseDecision {
  id                   String              @id @default(cuid())
  quoteItemMaterialId  String              @unique @map("quote_item_material_id")
  willPurchase         Boolean             @map("will_purchase")
  skipReason           MaterialSkipReason? @map("skip_reason")
  observations         String?
  decidedBy            String              @map("decided_by")
  decidedAt            DateTime            @default(now()) @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  quoteItemMaterial QuoteItemMaterial @relation(fields: [quoteItemMaterialId], references: [id], onDelete: Cascade)
  decidedByUser     User              @relation("MaterialPurchaseDecisionBy", fields: [decidedBy], references: [id])

  @@index([willPurchase])
  @@map("material_purchase_decisions")
}

