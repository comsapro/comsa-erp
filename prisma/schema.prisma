// COMSA ERP - Esquema de datos (Etapas 1, 2 y 3)
// Convencion: modelos en camelCase; columnas/tablas en snake_case via @map/@@map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------
enum RecordStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("record_status")
}

enum ItemType {
  PRODUCT
  RAW_MATERIAL
  CONSUMABLE
  TOOL
  EQUIPMENT
  SERVICE

  @@map("item_type")
}

enum SupplierType {
  PRODUCTS
  SERVICES
  BOTH

  @@map("supplier_type")
}

enum ProcessUnit {
  HOUR
  PIECE
  LOT
  METER
  KILOGRAM
  SERVICE

  @@map("process_unit")
}

enum CurrencyCode {
  MXN
  USD

  @@map("currency_code")
}

enum OrderType {
  GENERAL
  URGENT
  WAREHOUSE
  DIRECT_ORDER_REFERENCE

  @@map("order_type")
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PRODUCTION
  REJECTED
  CANCELLED

  @@map("quote_status")
}

enum QuoteAttachmentAudience {
  SALES
  PRODUCTION

  @@map("quote_attachment_audience")
}

enum DirectOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  QUOTED
  IN_PRODUCTION
  REJECTED
  CANCELLED

  @@map("direct_order_status")
}

enum ProductionSourceType {
  QUOTE
  DIRECT_ORDER

  @@map("production_source_type")
}

enum ProductionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REWORK

  @@map("production_status")
}

enum ProductionProcessSourceType {
  QUOTATION
  PRODUCTION

  @@map("production_process_source_type")
}

enum ProductionProcessStatus {
  PENDING
  COMPLETED
  REPLACED

  @@map("production_process_status")
}

enum ProductionItemPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("production_item_priority")
}

enum ProductionActivityType {
  NOTE
  STATUS
  HOURS_MANUAL
  SESSION_START
  SESSION_PAUSE
  SESSION_RESUME
  SESSION_END
  PROCESS_CHANGE
  INCIDENT
  MATERIAL
  PHOTO
  REOPEN
  CLOSE
  PLANNING

  @@map("production_activity_type")
}

enum ProductionIncidentStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED

  @@map("production_incident_status")
}

enum ProductionIncidentType {
  ORDER
  ITEM
  PROCESS
  MATERIAL
  MACHINERY
  DOCUMENTATION
  OTHER

  @@map("production_incident_type")
}

enum ProductionTimeSessionStatus {
  RUNNING
  PAUSED
  CLOSED

  @@map("production_time_session_status")
}

enum PurchaseOrderItemSourceType {
  QUOTE_MATERIAL
  MANUAL

  @@map("purchase_order_item_source_type")
}

enum FolioScope {
  QUOTE
  DIRECT_ORDER
  PRODUCTION
  INVENTORY_MOVEMENT
  WAREHOUSE_TRANSFER
  PURCHASE_ORDER
  PURCHASE_RECEIPT

  @@map("folio_scope")
}

enum DeliveryDaysType {
  BUSINESS
  CALENDAR

  @@map("delivery_days_type")
}

enum MovementType {
  ENTRY
  EXIT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_OUT
  TRANSFER_IN
  RESERVATION
  RELEASE

  @@map("movement_type")
}

enum MovementReferenceType {
  PURCHASE_ORDER
  PRODUCTION_ORDER
  PRODUCTION_ITEM
  DIRECT_ORDER
  MANUAL_ADJUSTMENT
  TRANSFER
  INITIAL_BALANCE

  @@map("movement_reference_type")
}

enum TransferStatus {
  DRAFT
  PENDING
  APPROVED
  COMPLETED
  CANCELLED

  @@map("transfer_status")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED

  @@map("purchase_order_status")
}

enum PurchaseOrderItemStatus {
  PENDING
  PARTIAL
  RECEIVED
  CANCELLED

  @@map("purchase_order_item_status")
}

// -----------------------------------------------------------------------------
// Autenticacion / Usuarios
// -----------------------------------------------------------------------------
model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  passwordHash       String       @map("password_hash")
  status             RecordStatus @default(ACTIVE)
  lastLoginAt        DateTime?    @map("last_login_at")
  mustChangePassword Boolean      @default(false) @map("must_change_password")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  roles               UserRole[]
  teamMemberships     TeamMember[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  quotesAsSeller      Quote[]              @relation("QuoteSeller")
  quotesApproved      Quote[]              @relation("QuoteApprovedBy")
  quotesRejected      Quote[]              @relation("QuoteRejectedBy")
  quotesCancelled     Quote[]              @relation("QuoteCancelledBy")
  directOrdersAsSeller DirectOrder[]       @relation("DirectOrderSeller")
  directOrdersApproved DirectOrder[]       @relation("DirectOrderApprovedBy")
  directOrdersRejected DirectOrder[]       @relation("DirectOrderRejectedBy")
  directOrdersCancelled DirectOrder[]      @relation("DirectOrderCancelledBy")
  productionItemsCompleted ProductionItem[] @relation("ProductionItemCompletedBy")
  productionItemNotesCreated ProductionItemNote[] @relation("ProductionItemNoteCreatedBy")
  productionMaterialsReady ProductionOrder[] @relation("ProductionMaterialsReadyBy")
  inventoryMovementsCreated InventoryMovement[] @relation("InventoryMovementCreatedBy")
  transfersRequested WarehouseTransfer[] @relation("TransferRequestedBy")
  transfersApproved WarehouseTransfer[] @relation("TransferApprovedBy")
  transfersCompleted WarehouseTransfer[] @relation("TransferCompletedBy")
  purchaseOrdersRequested PurchaseOrder[] @relation("PurchaseOrderRequestedBy")
  purchaseOrdersAuthorized PurchaseOrder[] @relation("PurchaseOrderAuthorizedBy")
  purchaseReceiptsReceived PurchaseReceipt[] @relation("PurchaseReceiptReceivedBy")
  quoteItemAttachmentsCreated QuoteItemAttachment[] @relation("QuoteItemAttachmentCreatedBy")
  productionAttachmentsCreated ProductionAttachment[] @relation("ProductionAttachmentCreatedBy")
  productionProcessesCreated ProductionItemProcess[] @relation("ProductionProcessCreatedBy")
  productionProcessesUpdated ProductionItemProcess[] @relation("ProductionProcessUpdatedBy")
  productionProcessesReplaced ProductionItemProcess[] @relation("ProductionProcessReplacedBy")
  productionItemsAssigned ProductionItem[] @relation("ProductionItemAssignedTo")
  productionItemsUpdated ProductionItem[] @relation("ProductionItemUpdatedBy")
  productionProcessesAssigned ProductionItemProcess[] @relation("ProductionProcessAssignedTo")
  productionActivitiesCreated ProductionActivity[] @relation("ProductionActivityCreatedBy")
  productionSessions ProductionTimeSession[] @relation("ProductionTimeSessionUser")
  productionIncidentsReported ProductionIncident[] @relation("ProductionIncidentReportedBy")
  productionIncidentsAssigned ProductionIncident[] @relation("ProductionIncidentAssignedTo")
  productionExtraMaterialsCreated ProductionExtraMaterial[] @relation("ProductionExtraMaterialCreatedBy")
  productionScheduleChangesCreated ProductionScheduleChange[] @relation("ProductionScheduleChangeCreatedBy")
  productionSettingsUpdated ProductionSetting[] @relation("ProductionSettingUpdatedBy")
  salesGoalsCreated SalesGoal[] @relation("SalesGoalCreatedBy")
  salesGoalsUpdated SalesGoal[] @relation("SalesGoalUpdatedBy")
  salesGoalMemberships SalesGoalSeller[]
  salesInvoicesAsSeller SalesInvoice[] @relation("SalesInvoiceSeller")
  salesInvoicesCreated SalesInvoice[] @relation("SalesInvoiceCreatedBy")
  salesInvoicesUpdated SalesInvoice[] @relation("SalesInvoiceUpdatedBy")
  materialPurchaseDecisions MaterialPurchaseDecision[] @relation("MaterialPurchaseDecisionBy")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  isSystem    Boolean      @default(false) @map("is_system")
  status      RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  permissions RolePermission[]
  users       UserRole[]
  teams       TeamRole[]

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  module      String
  action      String
  code        String  @unique
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Team {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  status      RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  members TeamMember[]
  roles   TeamRole[]
  salesGoals SalesGoalTeam[]

  @@index([status])
  @@index([deletedAt])
  @@map("teams")
}

model TeamMember {
  teamId String @map("team_id")
  userId String @map("user_id")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamRole {
  teamId String @map("team_id")
  roleId String @map("role_id")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([teamId, roleId])
  @@index([roleId])
  @@map("team_roles")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// -----------------------------------------------------------------------------
// Catalogos base
// -----------------------------------------------------------------------------
model Client {
  id              String       @id @default(cuid())
  commercialName  String       @map("commercial_name")
  legalName       String?      @map("legal_name")
  rfc             String?
  address         String?
  phone           String?
  email           String?
  mainContactName String?      @map("main_contact_name")
  companyProfile  String?      @map("company_profile")
  commercialTerms String?      @map("commercial_terms")
  status          RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  contacts ClientContact[]
  quotes   Quote[]
  directOrders DirectOrder[]
  productionOrders ProductionOrder[]

  @@index([status])
  @@index([deletedAt])
  @@map("clients")
}

model ClientContact {
  id        String  @id @default(cuid())
  clientId  String  @map("client_id")
  name      String
  position  String?
  phone     String?
  email     String?
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quotes Quote[]
  directOrders DirectOrder[]

  @@index([clientId])
  @@map("client_contacts")
}

model Supplier {
  id               String        @id @default(cuid())
  name             String
  legalName        String?       @map("legal_name")
  rfc              String?
  contactName      String?       @map("contact_name")
  phone            String?
  email            String?
  address          String?
  supplierType     SupplierType? @map("supplier_type")
  productsServices String?       @map("products_services")
  status           RecordStatus  @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  quoteItemMaterials QuoteItemMaterial[]
  quoteItemExtras    QuoteItemExtra[]
  templateMaterials  QuoteItemTemplateMaterial[]
  templateExtras     QuoteItemTemplateExtra[]
  purchaseOrders     PurchaseOrder[]
  purchaseReceipts   PurchaseReceipt[]
  productionExtraMaterials ProductionExtraMaterial[]

  @@index([status])
  @@index([deletedAt])
  @@map("suppliers")
}

model Warehouse {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  location    String?
  status      RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  quoteItems QuoteItem[]
  inventoryStock InventoryStock[]
  inventoryMovements InventoryMovement[] @relation("MovementWarehouse")
  inventoryMovementsDestination InventoryMovement[] @relation("MovementDestinationWarehouse")
  transfersAsSource WarehouseTransfer[] @relation("TransferSource")
  transfersAsDestination WarehouseTransfer[] @relation("TransferDestination")
  purchaseOrderItems PurchaseOrderItem[]
  purchaseReceipts PurchaseReceipt[]

  @@index([status])
  @@index([deletedAt])
  @@map("warehouses")
}

model ProductCategory {
  id          String       @id @default(cuid())
  name        String
  description String?
  parentId    String?      @map("parent_id")
  status      RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  items    Item[]

  @@index([parentId])
  @@index([deletedAt])
  @@map("product_categories")
}

model Item {
  id                    String       @id @default(cuid())
  sku                   String       @unique
  name                  String
  description           String?
  itemType              ItemType     @map("item_type")
  categoryId            String?      @map("category_id")
  unitOfMeasure         String?      @map("unit_of_measure")
  minimumStock          Decimal      @default(0) @map("minimum_stock") @db.Decimal(14, 3)
  isInventoryControlled Boolean      @default(true) @map("is_inventory_controlled")
  status                RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quoteItems QuoteItem[]
  quoteItemMaterials QuoteItemMaterial[]
  templateItems QuoteItemTemplate[] @relation("TemplateCatalogItem")
  templateMaterials QuoteItemTemplateMaterial[]
  directOrderItems DirectOrderItem[]
  inventoryStock InventoryStock[]
  inventoryMovements InventoryMovement[]
  transferItems WarehouseTransferItem[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  productionExtraMaterials ProductionExtraMaterial[]

  @@index([itemType])
  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
  @@map("items")
}

// -----------------------------------------------------------------------------
// Auditoria
// -----------------------------------------------------------------------------
model AuditLog {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  module       String
  entity       String
  entityId     String?  @map("entity_id")
  action       String
  previousData Json?    @map("previous_data")
  newData      Json?    @map("new_data")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Etapa 2 — Folios
// -----------------------------------------------------------------------------
model FolioSequence {
  id        String     @id @default(cuid())
  scope     FolioScope
  yearMonth String     @map("year_month")
  lastValue Int        @default(0) @map("last_value")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([scope, yearMonth])
  @@map("folio_sequences")
}

// -----------------------------------------------------------------------------
// Etapa 2 — Catalogos comerciales
// -----------------------------------------------------------------------------
model IssuingCompany {
  id               String       @id @default(cuid())
  commercialName   String       @map("commercial_name")
  legalName        String?      @map("legal_name")
  rfc              String?
  fiscalAddress    String?      @map("fiscal_address")
  phone            String?
  email            String?
  website          String?
  logoUrl          String?      @map("logo_url")
  bankDetails      String?      @map("bank_details")
  legalText        String?      @map("legal_text")
  quotationFooter  String?      @map("quotation_footer")
  status           RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  quotes       Quote[]
  directOrders DirectOrder[]

  @@index([status])
  @@index([deletedAt])
  @@map("issuing_companies")
}

model ManufacturingProcess {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  unit        ProcessUnit
  defaultRate Decimal      @default(0) @map("default_rate") @db.Decimal(14, 2)
  status      RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  quoteItemManufacturing    QuoteItemManufacturing[]
  templateManufacturing     QuoteItemTemplateManufacturing[]
  productionItemProcesses   ProductionItemProcess[]

  @@index([status])
  @@index([deletedAt])
  @@map("manufacturing_processes")
}

model InstallationConcept {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  description  String?
  unit         ProcessUnit
  defaultPrice Decimal      @default(0) @map("default_price") @db.Decimal(14, 2)
  status       RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  quoteItemInstallations QuoteItemInstallation[]
  templateInstallations  QuoteItemTemplateInstallation[]

  @@index([status])
  @@index([deletedAt])
  @@map("installation_concepts")
}

// -----------------------------------------------------------------------------
// Etapa 2 — Biblioteca de items de cotizacion
// -----------------------------------------------------------------------------
model QuoteItemTemplate {
  id                 String       @id @default(cuid())
  name               String
  category           String?
  description        String?
  defaultQuantity    Decimal      @default(1) @map("default_quantity") @db.Decimal(14, 3)
  unit               String?
  deliveryTimeMin    Int?         @map("delivery_time_min")
  deliveryTimeMax    Int?         @map("delivery_time_max")
  deliveryTimeUnit   String?      @map("delivery_time_unit")
  deliveryDaysType   DeliveryDaysType? @map("delivery_days_type")
  observations       String?
  benefitPercentage  Decimal      @default(30) @map("benefit_percentage") @db.Decimal(8, 2)
  itemId             String?      @map("item_id")
  status             RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  item            Item?                            @relation("TemplateCatalogItem", fields: [itemId], references: [id], onDelete: SetNull)
  manufacturing   QuoteItemTemplateManufacturing[]
  materials       QuoteItemTemplateMaterial[]
  extras          QuoteItemTemplateExtra[]
  installations   QuoteItemTemplateInstallation[]
  attachments     QuoteItemTemplateAttachment[]
  quoteItems      QuoteItem[]

  @@index([status])
  @@index([category])
  @@index([deletedAt])
  @@map("quote_item_templates")
}

model QuoteItemTemplateAttachment {
  id          String                   @id @default(cuid())
  templateId  String                   @map("template_id")
  pathname    String
  url         String?
  fileName    String                   @map("file_name")
  contentType String                   @map("content_type")
  sizeBytes   Int                      @map("size_bytes")
  audience    QuoteAttachmentAudience  @default(SALES)
  sortOrder   Int                      @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  template QuoteItemTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@unique([pathname])
  @@map("quote_item_template_attachments")
}

model QuoteItemTemplateManufacturing {
  id                     String      @id @default(cuid())
  templateId             String      @map("template_id")
  manufacturingProcessId String?     @map("manufacturing_process_id")
  processNameSnapshot    String      @map("process_name_snapshot")
  unitSnapshot           ProcessUnit @map("unit_snapshot")
  quantity               Decimal     @default(1) @db.Decimal(14, 3)
  unitRate               Decimal     @default(0) @map("unit_rate") @db.Decimal(14, 2)
  amount                 Decimal     @default(0) @db.Decimal(14, 2)
  observations           String?
  sortOrder              Int         @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  template QuoteItemTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  process  ManufacturingProcess? @relation(fields: [manufacturingProcessId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@map("quote_item_template_manufacturing")
}

model QuoteItemTemplateMaterial {
  id                  String  @id @default(cuid())
  templateId          String  @map("template_id")
  itemId              String? @map("item_id")
  supplierId          String? @map("supplier_id")
  descriptionSnapshot String  @map("description_snapshot")
  dimensions          String?
  presentation        String?
  unit                String?
  quantity            Decimal @default(1) @db.Decimal(14, 3)
  unitPrice           Decimal @default(0) @map("unit_price") @db.Decimal(14, 2)
  amount              Decimal @default(0) @db.Decimal(14, 2)
  observations        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  template QuoteItemTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  item     Item?             @relation(fields: [itemId], references: [id], onDelete: SetNull)
  supplier Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@map("quote_item_template_materials")
}

model QuoteItemTemplateExtra {
  id           String  @id @default(cuid())
  templateId   String  @map("template_id")
  description  String
  quantity     Decimal @default(1) @db.Decimal(14, 3)
  unit         String?
  unitPrice    Decimal @default(0) @map("unit_price") @db.Decimal(14, 2)
  amount       Decimal @default(0) @db.Decimal(14, 2)
  supplierId   String? @map("supplier_id")
  observations String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  template QuoteItemTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
