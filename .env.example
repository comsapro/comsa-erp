# =============================================================================
# COMSA ERP - Variables de entorno (Etapa 1)
# Copia este archivo a .env (local) o configuralo en tu proveedor (staging/prod)
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL en la nube: Neon / Supabase / RDS)
# -----------------------------------------------------------------------------
# Cadena de conexion usada por Prisma. Incluye ?sslmode=require en la nube.
DATABASE_URL="postgresql://usuario:password@host:5432/comsa_erp?schema=public&sslmode=require"

# -----------------------------------------------------------------------------
# Autenticacion (NextAuth v5 / Auth.js)
# -----------------------------------------------------------------------------
# Secreto para firmar las sesiones JWT. Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-de-32-caracteres"
# URL base de la app (requerida en staging/produccion)
AUTH_URL="http://localhost:3000"
# Confia en el host detras de un proxy (Vercel/Render). true en staging/prod.
AUTH_TRUST_HOST="true"

# -----------------------------------------------------------------------------
# Aplicacion / Ambiente
# -----------------------------------------------------------------------------
# Ambiente logico mostrado en el indicador de la UI: local | staging | production
NEXT_PUBLIC_APP_ENV="local"

# Datos del primer administrador (usados solo por el seed, nunca en runtime)
SEED_ADMIN_NAME="Administrador COMSA"
SEED_ADMIN_EMAIL="admin@comsa.com"
SEED_ADMIN_PASSWORD="Admin1234!"

# Ruta al dump MySQL legado (opcional; usado por npm run db:seed:legacy)
# LEGACY_DUMP_PATH="C:/Users/juanc/Downloads/comsa_2026-07-09.sql/comsa_2026-07-09.sql"

# -----------------------------------------------------------------------------
# Correo (recuperacion de acceso)
# En local, si no se define SMTP_HOST, el token se imprime en consola.
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@comsa.com"
